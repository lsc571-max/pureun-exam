{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com' && !root.child('admins').exists() && newData.val() === true"
      }
    },
    "exams": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "drafts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "sheets": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$exam": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (auth != null && root.child('users').child(auth.uid).exists() && (root.child('exams').child($exam).child('status').val() === 'running' || root.child('exams').child($exam).child('status').val() === 'ended' || root.child('exams').child($exam).child('practice').val() === true))"
      }
    },
    "images": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$exam": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (auth != null && root.child('users').child(auth.uid).exists() && (root.child('exams').child($exam).child('status').val() === 'running' || root.child('exams').child($exam).child('status').val() === 'ended' || root.child('exams').child($exam).child('practice').val() === true))"
      }
    },
    "keys": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$exam": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (auth != null && root.child('users').child(auth.uid).exists() && (root.child('exams').child($exam).child('released').val() === true || root.child('exams').child($exam).child('practice').val() === true))"
      }
    },
    "roster": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "bind": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$sid": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid && (root.child('roster').child($sid).exists() || !root.child('roster').exists()) && newData.parent().parent().child('users').child(auth.uid).child('sid').val() === $sid"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('sid').isString() && newData.child('name').isString() && newData.child('cls').isString() && newData.child('sid').val().matches(/^[A-Z0-9-]{4,20}$/) && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 20 && newData.child('cls').val().matches(/^[A-Z]$/) && (!root.child('roster').exists() || (root.child('roster').child(newData.child('sid').val()).child('name').val() === newData.child('name').val() && root.child('roster').child(newData.child('sid').val()).child('cls').val() === newData.child('cls').val())) && newData.parent().parent().child('bind').child(newData.child('sid').val()).val() === auth.uid",
        "$other": {
          ".validate": "$other === 'sid' || $other === 'name' || $other === 'cls' || $other === 'at'"
        }
      }
    },
    "answers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$exam": {
        "$sid": {
          ".read": "auth != null && root.child('bind').child($sid).val() === auth.uid",
          ".write": "auth != null && root.child('bind').child($sid).val() === auth.uid && root.child('exams').child($exam).child('status').val() === 'running' && now < root.child('exams').child($exam).child('endAt').val() + 20000 && !data.child('submittedAt').exists()",
          "a": {
            "$q": {
              ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 5000)"
            }
          },
          "ev": {
            "$e": {
              ".validate": "newData.child('t').isString() && newData.child('t').val().length <= 20 && newData.child('at').isNumber()"
            }
          },
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "submittedAt": {
            ".validate": "newData.isNumber()"
          },
          "sess": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "dev": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "essay": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$exam": {
        "$sid": {
          ".read": "auth != null && root.child('bind').child($sid).val() === auth.uid && root.child('exams').child($exam).child('released').val() === true"
        }
      }
    }
  }
}