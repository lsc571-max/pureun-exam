{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com' && !root.child('admins').exists() && newData.val() === true"
      }
    },
    "exams": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "classes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "entry": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "need": {
        ".read": "auth != null"
      }
    },
    "drafts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "sheets": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$exam": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (auth != null && root.child('users').child(auth.uid).exists() && (((root.child('exams').child($exam).child('status').val() === 'running' || root.child('exams').child($exam).child('status').val() === 'ended') && root.child('answers').child($exam).child(root.child('users').child(auth.uid).child('sid').val()).child('startedAt').exists()) || (root.child('exams').child($exam).child('practice').val() === true && (root.child('exams').child($exam).child('status').val() === 'draft' || root.child('exams').child($exam).child('status').val() === 'ended'))))"
      }
    },
    "images": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$exam": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (auth != null && root.child('users').child(auth.uid).exists() && (((root.child('exams').child($exam).child('status').val() === 'running' || root.child('exams').child($exam).child('status').val() === 'ended') && root.child('answers').child($exam).child(root.child('users').child(auth.uid).child('sid').val()).child('startedAt').exists()) || (root.child('exams').child($exam).child('practice').val() === true && (root.child('exams').child($exam).child('status').val() === 'draft' || root.child('exams').child($exam).child('status').val() === 'ended'))))"
      }
    },
    "keys": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$exam": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (auth != null && root.child('users').child(auth.uid).exists() && (root.child('exams').child($exam).child('released').val() === true || (root.child('exams').child($exam).child('practice').val() === true && (root.child('exams').child($exam).child('status').val() === 'draft' || root.child('exams').child($exam).child('status').val() === 'ended'))))"
      }
    },
    "bind": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$sid": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid && newData.parent().parent().child('users').child(auth.uid).child('sid').val() === $sid"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('sid').isString() && newData.child('name').isString() && newData.child('cls').isString() && newData.child('sid').val().matches(/^[A-Z0-9-]{4,20}$/) && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 20 && newData.child('cls').val().length >= 1 && newData.child('cls').val().length <= 20 && (!root.child('classes').exists() || root.child('classes').child(newData.child('cls').val()).exists()) && (!root.child('entry').child('code').exists() || newData.child('code').val() === root.child('entry').child('code').val()) && newData.parent().parent().child('bind').child(newData.child('sid').val()).val() === auth.uid",
        "at": {
          ".validate": "newData.isNumber()"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "$other": {
          ".validate": "$other === 'sid' || $other === 'name' || $other === 'cls'"
        }
      }
    },
    "answers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$exam": {
        "$sid": {
          ".read": "auth != null && root.child('bind').child($sid).val() === auth.uid",
          "a": {
            "$q": {
              ".write": "auth != null && root.child('bind').child($sid).val() === auth.uid && root.child('exams').child($exam).child('status').val() === 'running' && now < root.child('exams').child($exam).child('endAt').val() + 20000 && !root.child('answers').child($exam).child($sid).child('submittedAt').exists()",
              ".validate": "$q.matches(/^[A-Za-z0-9_-]{1,24}$/) && (newData.isNumber() || (newData.isString() && newData.val().length <= 5000))"
            }
          },
          "ev": {
            "$e": {
              ".write": "auth != null && root.child('bind').child($sid).val() === auth.uid && root.child('exams').child($exam).child('status').val() === 'running' && now < root.child('exams').child($exam).child('endAt').val() + 20000 && !root.child('answers').child($exam).child($sid).child('submittedAt').exists() && !data.exists()",
              ".validate": "newData.hasChildren(['t', 'at'])",
              "t": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() > now - 600000 && newData.val() < now + 600000"
              },
              "$o": {
                ".validate": false
              }
            }
          },
          "startedAt": {
            ".write": "auth != null && root.child('bind').child($sid).val() === auth.uid && root.child('exams').child($exam).child('status').val() === 'running' && now < root.child('exams').child($exam).child('endAt').val() + 20000 && !root.child('answers').child($exam).child($sid).child('submittedAt').exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() > now - 600000 && newData.val() < now + 600000"
          },
          "submittedAt": {
            ".write": "auth != null && root.child('bind').child($sid).val() === auth.uid && root.child('exams').child($exam).child('status').val() === 'running' && now < root.child('exams').child($exam).child('endAt').val() + 20000 && !root.child('answers').child($exam).child($sid).child('submittedAt').exists()",
            ".validate": "newData.isNumber() && newData.val() > now - 600000 && newData.val() < now + 600000"
          },
          "sess": {
            ".write": "auth != null && root.child('bind').child($sid).val() === auth.uid && root.child('exams').child($exam).child('status').val() === 'running' && now < root.child('exams').child($exam).child('endAt').val() + 20000 && !root.child('answers').child($exam).child($sid).child('submittedAt').exists()",
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "dev": {
            ".write": "auth != null && root.child('bind').child($sid).val() === auth.uid && root.child('exams').child($exam).child('status').val() === 'running' && now < root.child('exams').child($exam).child('endAt').val() + 20000 && !root.child('answers').child($exam).child($sid).child('submittedAt').exists()",
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "essay": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$exam": {
        "$sid": {
          ".read": "auth != null && root.child('bind').child($sid).val() === auth.uid && root.child('exams').child($exam).child('released').val() === true"
        }
      }
    }
  }
}